# Governed exceptions (PRD POL-004). Copy to .secure-dev/exceptions.yaml to use.
# Every entry requires reason, owner, createdAt, expiresAt. Expired entries
# never suppress. Secret findings need exceptions.allowSecretExceptions=true.
exceptions:
