# Secure SDLC Control Plane - configuration
# Copy to .env and fill in real values.

# Bitbucket workspace access token (scopes: repository:read, pullrequest:read)
BITBUCKET_ACCESS_TOKEN=
# Default workspace used when registering repos
BITBUCKET_WORKSPACE=

# Optional overrides
# BITBUCKET_API_BASE=https://api.bitbucket.org/2.0
# SCP_DATABASE_URL=sqlite:///./data/controlplane.db
# SCP_ZAP_API_URL=http://127.0.0.1:8080
# SCP_ZAP_API_KEY=
# Per-engine binary overrides (empty => rely on PATH / defaults)
# SCP_BANDIT_BIN=bandit
# SCP_OPENGREP_BIN=opengrep
# SCP_SEMGREP_BIN=semgrep
# SCP_TRIVY_BIN=trivy
# SCP_GITLEAKS_BIN=gitleaks

# Uploaded ZIP scan limits (bytes / counts)
# SCP_MAX_UPLOAD_BYTES=104857600          # 100 MB compressed upload
# SCP_MAX_EXPANDED_BYTES=524288000        # 500 MB expanded archive
# SCP_MAX_FILES=20000
# SCP_MAX_FILE_BYTES=52428800             # 50 MB single file
# SCP_MAX_COMPRESSION_RATIO=100

# Local OpenGrep/Semgrep rule pack directory
# SCP_RULES_PACK_DIR=rules/opengrep-rules
# SCP_MAX_CONCURRENT_ENGINES=4

# Trivy vulnerability scan tuning
# SCP_TRIVY_SEVERITY=CRITICAL,HIGH,MEDIUM   # severity list passed to trivy
# SCP_TRIVY_IGNORE_UNFIXED=1                # set to 1 to hide findings with no fix available

# OpenGrep/Semgrep registry fallback (offline-safe). When no local rules match
# and this is unset, the engine is skipped instead of hitting the network.
# SCP_OPENGREP_ALLOW_REGISTRY=1

# Bandit minimum severity filter (low/medium/high); empty = report everything
# SCP_BANDIT_MIN_SEVERITY=

# Auth (optional; when BOTH are set, HTTP Basic auth is enforced on the whole app)
# SCP_AUTH_USER=
# SCP_AUTH_PASS=
