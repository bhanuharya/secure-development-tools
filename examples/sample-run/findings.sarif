          "ruleId": "python.scp.python.crypto.weak-md5"
        },
        {
          "fingerprints": {
            "sdt-v2": "sha256:8dd4cd01cbfbda897c44e51ce666a319f88951a88173b5a5deb265452f83cece"
          },
          "level": "warning",
          "locations": [
            {
