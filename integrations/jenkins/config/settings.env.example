# Every setting the SDT scan jobs read, with its default. Nothing here is a secret:
# tokens and keys are Jenkins credentials (see the README), never variables.
#
# Set the ones you change as Jenkins global properties (Manage Jenkins > System >
# Global properties > Environment variables). A line left out keeps its default.

# --- required -----------------------------------------------------------------
SDT_SONAR_URL=https://sonar.example.com
SDT_WORKSPACE=my-workspace                 # Bitbucket workspace

# --- where scans run ----------------------------------------------------------
SDT_IMAGE=registry.example.com/appsec/sdt-scanner:1.0.0   # empty: tools installed on the agent
SDT_AGENT_LABEL=docker                     # agent label; empty: any agent
SDT_DOCKER_ARGS=-v sdt-state:/var/lib/sdt  # volume that keeps state between scans (see SDT_STATE_DIR)
#SDT_HOME=/opt/sdt                         # only without an image: the SDT checkout on the agent

# --- credentials (Jenkins credential ids) -------------------------------------
#SDT_SONAR_CREDENTIALS=sdt-sonar-token     # Secret text
#SDT_GIT_CREDENTIALS=sdt-bitbucket-ssh     # SSH key; "none" = the agent user's own key

# --- state kept between scans -------------------------------------------------
# The image sets SDT_STATE_DIR=/var/lib/sdt. Scan history (changes since the previous
# scan), AI verdict memory and the Codex login live under it; mount a volume there.
#SDT_STATE_DIR=/var/lib/sdt
#SDT_HISTORY_DIR=                          # default: $SDT_STATE_DIR/history
SDT_FLEET_DATABASE=postgresql+psycopg://sdt@db.example.com/sdt   # review decisions; empty: not recorded

# --- what a scan reports ------------------------------------------------------
#SDT_QUALITY_GATE_ENFORCE=0                # 1: a failed SonarQube gate fails the build
#MAIN_BRANCHES=main master                 # branches analysed as the SonarQube main branch
#SONAR_TEST_PATTERNS=**/test/**,**/tests/**,**/__tests__/**,**/*.test.*,**/*.spec.*,**/*_test.go,**/*_test.dart
#SONAR_CARRY_DECISIONS=1                   # 0: do not copy review decisions between branches
#SBOM=1                                    # 0: no CycloneDX SBOM
#SDT_REGISTRY_BLOCK_MINUTES=30             # after Maven Central blocks this machine (429), Java scans read
                                           # dependencies offline for this long instead of asking it again

# --- comment on the pull request (Bitbucket Cloud) ----------------------------
#SDT_BITBUCKET_API_CREDENTIALS=            # Secret text credential id; set: pull-request scans comment their result
#SDT_BITBUCKET_API_USER=                   # account email when the token is an API token; empty for an access token
#SDT_PR_REPORT_UPLOAD=1                    # 0: do not put the report in the repository's Downloads
#SDT_REPORTS_REPO=                         # repository every scan commits its report to; the comment links it

# --- AI review (needs the Codex CLI in the image and a login under CODEX_HOME) --
#SDT_AI_TRIAGE=1                           # 0: no model review; the built-in advisory is used
#SDT_AI_DIFF_REVIEW=0                      # 1: pull requests get ai-change-review.md (advice only)
#SDT_AI_AUTOCLOSE=0                        # 1: clear false positives are marked Safe in SonarQube
#SDT_CODEX_MODEL=gpt-6-luna
#SDT_CODEX_TIMEOUT=120                     # seconds per call
#SDT_CODEX_BUDGET=600                      # seconds for all calls of one scan
